{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Bun Server",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": false,
    "noUncheckedIndexedAccess": false,
    "types": ["bun-types"]
  }
}
